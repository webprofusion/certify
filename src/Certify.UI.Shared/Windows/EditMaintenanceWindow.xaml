<Controls:MetroWindow
    x:Class="Certify.UI.Windows.EditMaintenanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Certify.UI.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Edit Maintenance Window"
    Width="600"
    Height="650"
    Background="{DynamicResource MahApps.Brushes.Window.Background}"
    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    TitleCharacterCasing="Normal"
    WindowStartupLocation="CenterOwner"
    WindowTransitionsEnabled="False"
    mc:Ignorable="d">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button
                x:Name="Cancel"
                Width="100"
                Margin="0,0,8,0"
                Click="Cancel_Click">
                Cancel
            </Button>
            <Button
                x:Name="Save"
                Width="100"
                Click="Save_Click">
                Save
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Subheading}">Name</TextBlock>
                <TextBox
                    x:Name="WindowName"
                    Margin="0,4,0,16"
                    Controls:TextBoxHelper.Watermark="e.g., Nightly Maintenance"
                    Text="{Binding EditWindow.Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Subheading}">Description</TextBlock>
                <TextBox
                    x:Name="WindowDescription"
                    Height="60"
                    Margin="0,4,0,16"
                    AcceptsReturn="True"
                    Controls:TextBoxHelper.Watermark="Optional description of this maintenance window"
                    Text="{Binding EditWindow.Description, UpdateSourceTrigger=PropertyChanged}"
                    VerticalScrollBarVisibility="Auto" />

                <TextBlock Style="{StaticResource Subheading}">Days of Week</TextBlock>
                <WrapPanel Margin="0,8,0,8">
                    <ToggleButton
                        x:Name="DaySunday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Sunday">
                        Sunday
                    </ToggleButton>
                    <ToggleButton
                        x:Name="DayMonday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Monday">
                        Monday
                    </ToggleButton>
                    <ToggleButton
                        x:Name="DayTuesday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Tuesday">
                        Tuesday
                    </ToggleButton>
                    <ToggleButton
                        x:Name="DayWednesday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Wednesday">
                        Wednesday
                    </ToggleButton>
                    <ToggleButton
                        x:Name="DayThursday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Thursday">
                        Thursday
                    </ToggleButton>
                    <ToggleButton
                        x:Name="DayFriday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Friday">
                        Friday
                    </ToggleButton>
                    <ToggleButton
                        x:Name="DaySaturday"
                        Width="70"
                        Height="30"
                        Margin="4"
                        Click="DayToggle_Click"
                        Tag="Saturday">
                        Saturday
                    </ToggleButton>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button
                        Width="80"
                        Margin="4"
                        Click="SetAllDays_Click">
                        All Days
                    </Button>
                    <Button
                        Width="80"
                        Margin="4"
                        Click="SetWeekdays_Click">
                        Weekdays
                    </Button>
                    <Button
                        Width="80"
                        Margin="4"
                        Click="SetWeekends_Click">
                        Weekends
                    </Button>
                    <Button
                        Width="80"
                        Margin="4"
                        Click="SetNoDays_Click">
                        None
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource Subheading}">Time Range</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Margin="0,0,0,4">Start Time (24-hour format)</TextBlock>
                        <Controls:NumericUpDown
                            x:Name="StartHour"
                            Width="60"
                            Margin="0,0,4,0"
                            Minimum="0"
                            Maximum="23"
                            ValueChanged="Time_ValueChanged" />
                        <TextBlock Margin="0,4,0,0" Text="Hour" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Margin="0,0,0,4">:</TextBlock>
                        <Controls:NumericUpDown
                            x:Name="StartMinute"
                            Width="60"
                            Margin="0,0,4,0"
                            Minimum="0"
                            Maximum="59"
                            ValueChanged="Time_ValueChanged" />
                        <TextBlock Margin="0,4,0,0" Text="Minute" />
                    </StackPanel>
                    <StackPanel Margin="16,0,16,0">
                        <TextBlock Margin="0,0,0,4">End Time (24-hour format)</TextBlock>
                        <Controls:NumericUpDown
                            x:Name="EndHour"
                            Width="60"
                            Margin="0,0,4,0"
                            Minimum="0"
                            Maximum="23"
                            ValueChanged="Time_ValueChanged" />
                        <TextBlock Margin="0,4,0,0" Text="Hour" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4">:</TextBlock>
                        <Controls:NumericUpDown
                            x:Name="EndMinute"
                            Width="60"
                            Margin="0,0,4,0"
                            Minimum="0"
                            Maximum="59"
                            ValueChanged="Time_ValueChanged" />
                        <TextBlock Margin="0,4,0,0" Text="Minute" />
                    </StackPanel>
                </StackPanel>

                <Border
                    x:Name="OvernightWarning"
                    Margin="0,8,0,16"
                    Padding="8"
                    Background="{DynamicResource MahApps.Brushes.Accent4}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap">
                        This window spans overnight (e.g., starts one day and ends the next morning).
                    </TextBlock>
                </Border>

                <TextBlock Style="{StaticResource Subheading}">Timezone</TextBlock>
                <ComboBox
                    x:Name="TimeZoneSelector"
                    Margin="0,4,0,16"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="TimeZoneSelector_SelectionChanged"
                    SelectedValuePath="Id" />

                <CheckBox
                    x:Name="IsEnabled"
                    Margin="0,8,0,16"
                    Content="Enabled"
                    IsChecked="{Binding EditWindow.IsEnabled}" />

                <Border
                    Margin="0,8,0,0"
                    Padding="8"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold">Schedule Preview:</TextBlock>
                        <TextBlock
                            x:Name="SchedulePreview"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Controls:MetroWindow>
