{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Microsoft": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  // Note: JwtSettings.secret is deliberately NOT set here. It is generated per-install into
  // hubservice.json in the app data path on first run. A secret committed to this file would be
  // published with the product and would let anyone forge tokens for any security principal.
  "JwtSettings": {
    "refreshTokenExpirationInMinutes": 1440,
    "authTokenExpirationInMinutes": 60,
    "issuer": "Certify.Server.Hub.Api"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Certify": "Information",
        "Certify.Server.Hub.Api.Controllers": "Information"
      }
    }
  }
}
