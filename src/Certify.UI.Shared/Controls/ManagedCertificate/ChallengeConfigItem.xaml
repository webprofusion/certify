<UserControl
    x:Class="Certify.UI.Controls.ManagedCertificate.ChallengeConfigItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Resources="clr-namespace:Certify.Locales;assembly=Certify.Locales"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:local="clr-namespace:Certify.UI.Windows"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Certify.Models;assembly=Certify.Models"
    xmlns:validation="clr-namespace:Certify.Models.Shared.Validation;assembly=Certify.Models"
    d:DesignHeight="200"
    d:DesignWidth="468"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ProviderMultiLineStringParameter">

            <StackPanel
                Margin="0,8,0,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <Label Width="160" Content="{Binding Name}" />
                <TextBox
                    Width="250"
                    Height="100"
                    mah:TextBoxHelper.Watermark="{Binding Description}"
                    AcceptsReturn="True"
                    KeyUp="OnParameterModified"
                    Text="{Binding Value}"
                    ToolTip="{Binding Description}"
                    VerticalScrollBarVisibility="Visible" />
            </StackPanel>

        </DataTemplate>
        <DataTemplate x:Key="ProviderStringParameter">
            <StackPanel
                Margin="0,8,0,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <Label Width="160" Content="{Binding Name}" />
                <TextBox
                    Width="250"
                    mah:TextBoxHelper.Watermark="{Binding Description}"
                    KeyUp="OnParameterModified"
                    Text="{Binding Value}" />
                <Button
                    x:Name="ShowParamLookup"
                    Padding="4"
                    Click="ShowParamLookup_Click">
                    <Button.Style>
                        <Style>
                            <Setter Property="UIElement.Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Key}" Value="zoneid">
                                    <Setter Property="UIElement.Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    ...
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ProviderDropDownParameter">
            <StackPanel
                Margin="0,8,0,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <Label Width="160" Content="{Binding Name}" />
                <ComboBox
                    Width="250"
                    Binding.SourceUpdated="OnParameterModified"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding Options}"
                    SelectedValue="{Binding Value, NotifyOnSourceUpdated=True}"
                    SelectedValuePath="Key" />
            </StackPanel>

        </DataTemplate>
        <DataTemplate x:Key="ProviderPasswordParameter">
            <StackPanel
                Margin="0,8,0,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <Label Width="160" Content="{Binding Name}" />
                <PasswordBox
                    Width="250"
                    local:PasswordBoxAssistant.BindPassword="True"
                    local:PasswordBoxAssistant.BoundPassword="{Binding Value, Mode=TwoWay}"
                    KeyUp="OnParameterModified" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ProviderHiddenParameter" />

        <DataTemplate x:Key="ProviderBooleanParameter">
            <StackPanel
                Margin="0,8,0,0"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <Label Width="160" Content="{Binding Name}" />
                <CheckBox Binding.SourceUpdated="OnParameterModified" IsChecked="{Binding Value, Mode=TwoWay, NotifyOnSourceUpdated=True}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>

        <!--  challenge type selection  -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Label Width="160" Content="{x:Static Resources:SR.ManagedCertificateSettings_ChallengeTypes}" />
            <ComboBox
                x:Name="ChallengeTypeList"
                Width="270"
                ItemsSource="{Binding ChallengeTypes}"
                SelectedItem="{Binding SelectedItem.ChallengeType}"
                SelectionChanged="ChallengeTypeList_SelectionChanged" />
        </StackPanel>

        <!--  http-01 Challenge Config UI  -->
        <StackPanel x:Name="ChallengeConfigHttp" DockPanel.Dock="Top">
            <StackPanel.Style>
                <Style>
                    <Setter Property="UIElement.Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.ChallengeType}" Value="{x:Static models:SupportedChallengeTypes.CHALLENGE_TYPE_HTTP}">
                            <Setter Property="UIElement.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <StackPanel Margin="160,0,0,0">
                <TextBlock Style="{StaticResource Instructions}"><Run Text="For HTTP validation the app will automatically create the challenge response file required. Your server must allow http requests on port 80 (https redirections permitted)." /></TextBlock>
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Label Width="160" Content="{x:Static Resources:SR.ManagedCertificateSettings_WebsiteRoot}" />
                <TextBox
                    Width="225"
                    mah:TextBoxHelper.Watermark="(optional, leave blank to auto discover)"
                    Text="{Binding SelectedItem.ChallengeRootPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Name="Button_WebRoot"
                    Margin="4,0,0,0"
                    Click="DirectoryBrowse_Click"
                    Content="{x:Static Resources:SR.ManagedCertificateSettings_BrowseFolder}" />
            </StackPanel>

            <StackPanel Margin="160,8,0,0" Orientation="Vertical">
                <CheckBox Content="{x:Static Resources:SR.ManagedCertificateSettings_PerformChallengeResponseConfigCheck}" IsChecked="{Binding ParentManagedCertificate.RequestConfig.PerformExtensionlessConfigChecks}" />
                <CheckBox Content="{x:Static Resources:SR.ManagedCertificateSettings_PerformWebAppAutoConfig}" IsChecked="{Binding ParentManagedCertificate.RequestConfig.PerformAutoConfig}" />
            </StackPanel>

        </StackPanel>

        <!--  dns-01 Challenge Config UI  -->
        <StackPanel x:Name="ChallengeConfigDns" DockPanel.Dock="Top">
            <StackPanel.Style>
                <Style>
                    <Setter Property="UIElement.Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.ChallengeType}" Value="{x:Static models:SupportedChallengeTypes.CHALLENGE_TYPE_DNS}">
                            <Setter Property="UIElement.Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.ChallengeType}" Value="{x:Static models:SupportedChallengeTypes.CHALLENGE_TYPE_DNS_ACCOUNT}">
                            <Setter Property="UIElement.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <StackPanel Margin="160,0,0,0">
                <TextBlock Style="{StaticResource Instructions}"><Run Text="For DNS validation the app will need to create a 'TXT' record in the DNS zone of your domain(s) as an answer to the authorization challenge." /></TextBlock>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource Instructions}" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem.ChallengeType}" Value="{x:Static models:SupportedChallengeTypes.CHALLENGE_TYPE_DNS_ACCOUNT}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="dns-account-01 (draft) works like dns-01, but the record is at _&lt;account label&gt;._acme-challenge.&lt;domain&gt;, where the label is derived from the ACME account, so several accounts or ACME clients can validate the same domain without conflicting. The CA must support dns-account-01." />
                    <LineBreak />
                    <Hyperlink NavigateUri="{Binding Source={x:Static validation:DnsAccountLabel.SpecificationUrl}}" RequestNavigate="HelpUrl_RequestNavigate">Read the specification</Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Width="160" Content="DNS Update Method:" />

                    <ComboBox
                        x:Name="ChallengeAPIProviderList"
                        Width="270"
                        Margin="0,0,0,0"
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding ChallengeProviders}"
                        SelectedValue="{Binding SelectedItem.ChallengeProvider, Mode=OneTime}"
                        SelectedValuePath="Id"
                        SelectionChanged="ChallengeAPIProviderList_SelectionChanged" />
                </StackPanel>

                <StackPanel
                    Margin="160,8,8,0"
                    DockPanel.Dock="Top"
                    Orientation="Vertical">
                    <TextBlock Style="{StaticResource Instructions}">
                        <Span>
                            <Run Text="{Binding SelectedChallengeProvider.Description}" />
                            <LineBreak />
                            <Hyperlink
                                x:Name="HelpUrl"
                                NavigateUri="{Binding SelectedChallengeProvider.HelpUrl}"
                                RequestNavigate="HelpUrl_RequestNavigate"
                                ToolTip="{Binding SelectedChallengeProvider.HelpUrl}">
                                Browse Documentation
                            </Hyperlink>
                        </Span>

                    </TextBlock>

                </StackPanel>

                <StackPanel x:Name="ProviderCredentials" Orientation="Vertical">
                    <StackPanel.Style>
                        <Style>
                            <Setter Property="UIElement.Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesCredentials}" Value="True">
                                    <Setter Property="UIElement.Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Label Width="160" Content="Credentials" />

                        <ComboBox
                            x:Name="StoredCredentialList"
                            Width="225"
                            Margin="0,0,8,0"
                            DisplayMemberPath="Title"
                            ItemsSource="{Binding FilteredCredentials}"
                            SelectedValue="{Binding SelectedItem.ChallengeCredentialKey, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="StorageKey" />

                        <Button
                            x:Name="AddStoredCredential"
                            Click="AddStoredCredential_Click"
                            Content="New" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="160,8,0,0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style>
                        <Setter Property="UIElement.Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowZoneLookup}" Value="True">
                                <Setter Property="UIElement.Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Orientation="Horizontal">
                    <ComboBox
                        x:Name="DnsZoneList"
                        Width="270"
                        Margin="0,0,0,0"
                        DisplayMemberPath="Name"
                        DropDownOpened="DnsZoneList_DropDownOpened"
                        ItemsSource="{Binding DnsZones}"
                        SelectedValuePath="ZoneId"
                        SelectionChanged="DnsZoneList_SelectionChanged" />
                    <fa:ImageAwesome
                        x:Name="RefreshingDnsZones"
                        Height="12"
                        Margin="4,0,0,0"
                        Foreground="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        Icon="Refresh"
                        Spin="True"
                        SpinDuration="1"
                        Visibility="{Binding IsZoneLookupInProgress, Converter={StaticResource ResourceKey=BoolToVisConverter}}" />
                </StackPanel>

            </StackPanel>

            <ItemsControl
                MinHeight="30"
                DockPanel.Dock="Top"
                ItemsSource="{Binding ProviderParameters, UpdateSourceTrigger=PropertyChanged}">
                <ItemsControl.ItemTemplateSelector>
                    <local:ControlTemplateSelector />
                </ItemsControl.ItemTemplateSelector>
            </ItemsControl>

            <StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Label Width="160" Content="CNAME Delegation Rule" />
                    <TextBox
                        x:Name="ChallengeDelegationRule"
                        Width="270"
                        mah:TextBoxHelper.Watermark="(optional) *.example.com:*.auth.example.org"
                        Text="{Binding SelectedItem.ChallengeDelegationRule, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="160,0,0,0">
                    <TextBlock Style="{StaticResource Instructions}"><Run Text="Only required if you intend to delegate _acme-challenge TXT records to another domain via CNAME." /></TextBlock>
                </StackPanel>

            </StackPanel>

        </StackPanel>

        <StackPanel x:Name="ChallengeConfigDnsPersist" DockPanel.Dock="Top">
            <StackPanel.Style>
                <Style>
                    <Setter Property="UIElement.Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.ChallengeType}" Value="{x:Static models:SupportedChallengeTypes.CHALLENGE_TYPE_DNS_PERSIST}">
                            <Setter Property="UIElement.Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <StackPanel Margin="160,0,0,0">
                <TextBlock Style="{StaticResource Instructions}" TextWrapping="Wrap">
                    <Run Text="dns-persist-01 uses a persistent DNS TXT record that is set up once and reused for future renewals. It is suitable for environments where real-time DNS updates are impractical." />
                    <Run Text="Each record is for one CA and one ACME account: staging and production accounts need separate records, and several CAs can each have their own record at the same name." />
                    <LineBreak />
                    <Hyperlink NavigateUri="{Binding Source={x:Static validation:DnsPersistRecordBuilder.SpecificationUrl}}" RequestNavigate="HelpUrl_RequestNavigate">Read the specification</Hyperlink>
                </TextBlock>
            </StackPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TabControl Grid.Column="1">
                    <TabItem mah:HeaderedControlHelper.HeaderFontSize="12" Header="Records">
                        <StackPanel Margin="8">
                            <TextBlock
                                Style="{StaticResource Instructions}"
                                Text="{Binding DnsPersistFormatDescription}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="DarkOrange"
                                Text="{Binding DnsPersistIssuerPlaceholderWarning}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasNoDnsPersistIssuers, Converter={StaticResource ResourceKey=BoolToVisConverter}}" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="DarkOrange"
                                Text="The persistUntil date has passed, so the CA would not use these records."
                                TextWrapping="Wrap"
                                Visibility="{Binding IsDnsPersistUntilPassed, Converter={StaticResource ResourceKey=BoolToVisConverter}}" />

                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DnsPersistRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Content="Name" />
                                            <TextBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                IsReadOnly="True"
                                                Text="{Binding Name, Mode=OneWay}" />
                                            <Button
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="4,0,0,0"
                                                Click="CopyDnsPersistValue_Click"
                                                Content="Copy"
                                                Tag="{Binding Name}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Content="TXT Value" />
                                            <TextBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,4,0,0"
                                                IsReadOnly="True"
                                                Text="{Binding Value, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="4,4,0,0"
                                                Click="CopyDnsPersistValue_Click"
                                                Content="Copy"
                                                Tag="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Style="{StaticResource Instructions}"
                                Text="As zone file entries (values over 255 characters are split into several strings):"
                                TextWrapping="Wrap" />
                            <TextBox
                                Margin="0,4,0,0"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                Text="{Binding DnsPersistZoneFileText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </TabItem>

                    <TabItem mah:HeaderedControlHelper.HeaderFontSize="12" Header="Record Options">
                        <StackPanel Margin="8">
                            <TextBlock
                                Margin="0,0,0,8"
                                Foreground="DarkOrange"
                                Text="No ACME accounts found. Add an account under Settings before using dns-persist-01.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDnsPersistAccounts}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal">
                                <Label Width="160" Content="Certificate Authority" />
                                <ComboBox
                                    Width="270"
                                    DisplayMemberPath="Title"
                                    ItemsSource="{Binding DnsPersistAccounts}"
                                    ToolTip="The records are for the account a request for this CA uses. Choose the certificate's CA."
                                    SelectedValue="{Binding SelectedDnsPersistAccountUri, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="AccountURI" />
                            </StackPanel>

                            <StackPanel
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasMultipleDnsPersistIssuers, Converter={StaticResource ResourceKey=BoolToVisConverter}}">
                                <Label Width="160" Content="Issuer Domain Name" />
                                <ComboBox
                                    Width="270"
                                    ItemsSource="{Binding DnsPersistIssuerOptions}"
                                    SelectedItem="{Binding SelectedDnsPersistIssuer, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="4,8,0,0" Orientation="Vertical">
                                <CheckBox Content="Include policy=wildcard (authorizes wildcard and subdomain certificates)" IsChecked="{Binding DnsPersistPolicyWildcard, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource Instructions}"
                                    Text="Records for wildcard identifiers always include policy=wildcard."
                                    Visibility="{Binding DnsPersistHasWildcardIdentifiers, Converter={StaticResource ResourceKey=BoolToVisConverter}}" />
                            </StackPanel>

                            <StackPanel
                                Margin="4,8,0,0"
                                Orientation="Vertical"
                                Visibility="{Binding IsDnsPersistHashed, Converter={StaticResource ResourceKey=BoolToVisConverter}}">
                                <CheckBox Content="Use one account value for every domain (domain name *)" IsChecked="{Binding DnsPersistUseDomainOptOut, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource Instructions}"
                                    Text="By default each domain's record has its own hashed account value, so records for different domains cannot be linked to one account. With this option every record has the same value."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Label Width="160" Content="persistUntil (optional)" />
                                <DatePicker SelectedDate="{Binding DnsPersistUntilDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="160,0,0,0">
                                <TextBlock Style="{StaticResource Instructions}" TextWrapping="Wrap">
                                    <Run Text="Optional date from which (00:00 UTC) the CA will not use this record for new validations." />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasMultipleChallengeConfigurations, Converter={StaticResource ResourceKey=BoolToVisConverter}}">
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Label Width="160" Content="Domain Match" />
                <TextBox
                    x:Name="DomainMatchText"
                    Width="270"
                    mah:TextBoxHelper.Watermark="(optional) *.example.com; www.sub.example.com"
                    Text="{Binding SelectedItem.DomainMatch, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="160,0,0,0">
                <TextBlock Style="{StaticResource Instructions}"><Run Text="A domain match rule is only required when validating multiple domains using different methods in one certificate." /></TextBlock>
            </StackPanel>

        </StackPanel>


        <Button
            x:Name="DeleteAuth"
            MaxWidth="160"
            Margin="8,16,0,0"
            HorizontalAlignment="Left"
            Click="DeleteAuth_Click"
            DockPanel.Dock="Bottom"
            Tag="{Binding SelectedItem}">
            Delete Configuration
        </Button>
    </DockPanel>

</UserControl>
