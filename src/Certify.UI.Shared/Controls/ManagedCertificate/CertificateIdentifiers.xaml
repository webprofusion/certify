<UserControl
    x:Class="Certify.UI.Controls.ManagedCertificate.CertificateIdentifiers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls"
    xmlns:Resources="clr-namespace:Certify.Locales;assembly=Certify.Locales"
    xmlns:certifyui="clr-namespace:Certify.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:managedcertificate="clr-namespace:Certify.UI.Controls.ManagedCertificate"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="clr-namespace:Certify.UI.Utils"
    d:DataContext="{d:DesignInstance Type=certifyui:ManagedCertificateViewModelDesign,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <utils:InverseBooleanConverter x:Key="InvBoolConverter" />
        <utils:NullVisibilityConverter x:Key="NullCollapsedConverter" />
        <utils:ManagedCertificateHealthVisibilityConverter x:Key="HealthVisibleConverter" />
        <utils:NullVisibilityConverter
            x:Key="NullVisibleConverter"
            NotNull="Collapsed"
            Null="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <TabControl
            x:Name="MainTabControl"
            Height="auto"
            Margin="0,0,0,0"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Stretch"
            Controls:TabControlHelper.UnderlineBrush="{DynamicResource MahApps.Brushes.Accent4}"
            Controls:TabControlHelper.Underlined="TabPanel">
            <TabItem
                MinWidth="100"
                Controls:HeaderedControlHelper.HeaderFontSize="12"
                Header="Identifiers"
                IsSelected="False">

                <DockPanel LastChildFill="True">
                    <DockPanel
                        Margin="8,0,8,8"
                        DockPanel.Dock="Top"
                        Visibility="{Binding IsEditable, Converter={StaticResource ResourceKey=BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <StackPanel Orientation="Horizontal">
                            <Label Width="200" Content="Use External Subscription" />
                            <CheckBox
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsExternalSubscriptionMode, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Switch this managed certificate to use an external source subscription instead of ACME request/authorization settings." />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel
                        Margin="8,0,8,8"
                        DockPanel.Dock="Top"
                        Visibility="{Binding IsExternalManagedCertificateItem, Converter={StaticResource ResourceKey=BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Instructions}">
                            Configure how this externally managed certificate is synchronized from its source.
                        </TextBlock>

                        <StackPanel Margin="0,12,0,0" Orientation="Vertical">
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Label Width="200" Content="Subscription Enabled" />
                                <CheckBox IsChecked="{Binding SelectedItem.ExternalSource.IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Label Width="200" Content="Source Type" />
                                <ComboBox
                                    Width="240"
                                    ItemsSource="{Binding ExternalSourceTypes}"
                                    SelectedItem="{Binding SelectedItem.ExternalSource.SourceType, UpdateSourceTrigger=PropertyChanged}"
                                    SelectionChanged="ExternalSourceType_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Label Width="200" Content="Retrieval Mode" />
                                <ComboBox
                                    Width="240"
                                    ItemsSource="{Binding ExternalRetrievalModes}"
                                    SelectedItem="{Binding SelectedItem.ExternalSource.RetrievalMode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Margin="0,4,0,0" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Width="200" Content="External Reference" />
                                    <TextBlock
                                        Width="360"
                                        VerticalAlignment="Center"
                                        Text="{Binding SelectedItem.ExternalSource.ExternalReference}" />
                                </StackPanel>

                                <StackPanel Margin="200,4,0,0" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.ExternalSource.SourceType}" Value="ManagementHub">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox
                                        x:Name="HubCertificateBrowser"
                                        Width="320"
                                        Controls:TextBoxHelper.Watermark="Browse available hub certificates..."
                                        ItemsSource="{Binding SubscribableManagedCertificates}"
                                        SelectedItem="{Binding SelectedSubscribableCertificate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <TextBlock Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="{Binding InstanceTitle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        Margin="4,0,0,0"
                                        Click="LoadHubCertificates_Click"
                                        Content="Load"
                                        IsEnabled="{Binding IsLoadingSubscribableCertificates, Converter={StaticResource ResourceKey=InvBoolConverter}}" />
                                </StackPanel>

                                <TextBlock
                                    Margin="200,6,0,0"
                                    Foreground="{DynamicResource WarningColorBrush}"
                                    Text="No certificates are currently permitted by the hub for this instance. Review the subscription policy on the hub."
                                    TextWrapping="Wrap"
                                    Visibility="{Binding ShowNoSubscribableManagedCertificatesIndicator, Converter={StaticResource ResourceKey=BoolToVisConverter}}" />
                            </StackPanel>

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.ExternalSource.SourceType}" Value="ManagementHub">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Label Width="200" Content="Credential" />
                                <ComboBox
                                    x:Name="ExternalSourceCredential"
                                    Width="240"
                                    DisplayMemberPath="Title"
                                    ItemsSource="{Binding ExternalSourceCredentials}"
                                    SelectedItem="{Binding SelectedExternalCredential, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Margin="4,0,0,0"
                                    Click="AddExternalSourceCredential_Click"
                                    Content="New" />
                            </StackPanel>

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.ExternalSource.SourceType}" Value="ManagementHub">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Label Width="200" Content="Poll Interval Minutes" />
                                <ComboBox
                                    Width="240"
                                    ItemsSource="{Binding ExternalPollingIntervals}"
                                    SelectedItem="{Binding SelectedItem.ExternalSource.PollIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,16,0,0"
                                FontWeight="SemiBold"
                                Text="Sync Status" />

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Label Width="200" Content="Last Source Version" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedItem.ExternalSource.LastSourceVersion}" />
                            </StackPanel>

                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Label Width="200" Content="Last Source Error" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding SelectedItem.ExternalSource.LastError}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel
                        DockPanel.Dock="Top"
                        Orientation="Vertical"
                        Visibility="{Binding ShowStandardIdentifiersEditor, Converter={StaticResource ResourceKey=BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <DockPanel Margin="8,0,8,8" Visibility="{Binding SelectedItem.RequestConfig.CustomCSR, Converter={StaticResource ResourceKey=NullVisibleConverter}}">

                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Instructions}"><Run Text="{x:Static Resources:SR.ManagedCertificateSettings_DomainsIntro}" /></TextBlock>

                            <StackPanel
                                Margin="0,8,0,0"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                                <Label
                                    x:Name="SelectWebsite"
                                    Width="160"
                                    AutomationProperties.Name="{x:Static Resources:SR.ManagedCertificateSettings_SelectWebsite}"
                                    Content="{x:Static Resources:SR.ManagedCertificateSettings_SelectWebsite}" />
                                <ComboBox
                                    x:Name="WebsiteDropdown"
                                    Width="240"
                                    AutomationProperties.HelpText="You can optionally select a site hosted on this server to populate the list of domains in your certificate. "
                                    AutomationProperties.Name="{x:Static Resources:SR.ManagedCertificateSettings_SelectWebsite}"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding WebSiteList, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding SelectedWebSite}"
                                    SelectionChanged="Website_SelectionChanged">

                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="ToolTip" Value="Site currently has no https bindings" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCertificate}" Value="true">
                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Highlight}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="ToolTip" Value="Site already has one or more https bindings" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <Button
                                    Width="32"
                                    Margin="0,0,4,0"
                                    AutomationProperties.Name="Refresh Sites"
                                    BorderThickness="0"
                                    Click="RefreshWebsiteList_Click"
                                    ToolTip="Refresh Site List">
                                    <fa:ImageAwesome
                                        Height="12"
                                        Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                        Icon="Refresh"
                                        Spin="{Binding IsSiteListQueryProgress}" />

                                </Button>

                            </StackPanel>

                            <StackPanel
                                x:Name="ManualDomainEntry"
                                Margin="0,8,0,0"
                                DockPanel.Dock="Top"
                                Orientation="Vertical">

                                <StackPanel Orientation="Horizontal">
                                    <Label Width="160" Content="{x:Static Resources:SR.ManagedCertificateSettings_AddDomainsToCertificate}" />
                                    <TextBox
                                        x:Name="ManualDomains"
                                        Width="240"
                                        Controls:TextBoxHelper.Watermark="{x:Static Resources:SR.ManagedCertificateSettings_AddDomainsHelpText}"
                                        AutomationProperties.HelpText="{x:Static Resources:SR.ManagedCertificateSettings_AddDomainsHelpText}"
                                        AutomationProperties.Name="{x:Static Resources:SR.ManagedCertificateSettings_AddDomainsToCertificate}"
                                        KeyUp="ManualDomains_KeyUp" />

                                    <Button
                                        x:Name="AddDomains"
                                        Width="32"
                                        Margin="0,0,0,0"
                                        AutomationProperties.Name="Add Domains"
                                        BorderThickness="0"
                                        Click="AddDomains_Click"
                                        ToolTip="Add Domains">
                                        <fa:ImageAwesome
                                            Height="12"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                            Icon="Plus" />

                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                x:Name="NoBindings"
                                Margin="0,4,0,0"
                                DockPanel.Dock="Top"
                                Orientation="Vertical"
                                Visibility="{Binding HasSelectedItemDomainOptions, Converter={StaticResource ResourceKey=InvBoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <TextBlock
                                    Margin="0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource WarningColorBrush}"
                                    TextWrapping="WrapWithOverflow"><Run Text="{x:Static Resources:SR.ManagedCertificateSettings_NoHostNameBindingWarning}" /></TextBlock>
                                <TextBlock
                                    Margin="0,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    TextWrapping="WrapWithOverflow"><Run Text="Alternatively, if you require a certificate for a Telephone Number Authorization List: " /><Hyperlink Click="AddTkAuthList_Click">Add Authority Tokens</Hyperlink></TextBlock>

                            </StackPanel>

                            <StackPanel
                                x:Name="InvalidConfig"
                                Margin="0,4,0,0"
                                DockPanel.Dock="Top"
                                Orientation="Vertical"
                                Visibility="{Binding HasInvalidPrimaryDomainConfig, Converter={StaticResource ResourceKey=BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <TextBlock
                                    Margin="8,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource ErrorColorBrush}"
                                    TextWrapping="WrapWithOverflow">
                                    There can be only one Primary Domain included on a certificate. There are currently multiple domains configured as the Primary, please review and correct the primary domain selection.
                                </TextBlock>
                            </StackPanel>
                            <DockPanel
                                x:Name="DomainOptions"
                                Margin="0,8,0,0"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding HasSelectedItemDomainOptions, Converter={StaticResource ResourceKey=BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <Label
                                    Content="{x:Static Resources:SR.ManagedCertificateSettings_SelectDomain}"
                                    DockPanel.Dock="Top"
                                    FontWeight="Bold" />
                                <StackPanel
                                    Margin="0,4,0,4"
                                    DockPanel.Dock="Top"
                                    Orientation="Horizontal">

                                    <Button
                                        Width="32"
                                        Margin="0,0,4,0"
                                        AutomationProperties.Name="Select All"
                                        BorderThickness="0"
                                        Command="{Binding SANSelectAllCommand}"
                                        ToolTip="{x:Static Resources:SR.SelectAll}">
                                        <fa:ImageAwesome
                                            Height="12"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                            Icon="CheckSquare" />

                                    </Button>

                                    <Button
                                        Width="32"
                                        Margin="0,0,4,0"
                                        AutomationProperties.Name="Select None"
                                        BorderThickness="0"
                                        Command="{Binding SANSelectNoneCommand}"
                                        ToolTip="{x:Static Resources:SR.ManagedCertificateSettings_SelectNone}">
                                        <fa:ImageAwesome
                                            Height="12"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                            Icon="SquareOutline" />

                                    </Button>


                                    <Button
                                        Width="32"
                                        Margin="0,0,4,0"
                                        AutomationProperties.Name="Refresh Domains"
                                        BorderThickness="0"
                                        Click="RefreshSanList_Click"
                                        ToolTip="{x:Static Resources:SR.ManagedCertificatesSettings_RefreshDomains}">
                                        <fa:ImageAwesome
                                            Height="12"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                            Icon="Refresh" />

                                    </Button>

                                    <Label Content="Filter:" />
                                    <TextBox
                                        x:Name="DomainFilter"
                                        Width="120"
                                        AutomationProperties.Name="Filter domains"
                                        TextChanged="DomainFilter_TextChanged" />

                                </StackPanel>
                                <DataGrid
                                    x:Name="DomainOptionsList"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    EnableRowVirtualization="True"
                                    ItemsSource="{Binding SelectedItem.DomainOptions}"
                                    MouseLeftButtonUp="ToggleSelectedDomainOption"
                                    ScrollViewer.CanContentScroll="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="Single"
                                    VirtualizingPanel.IsVirtualizing="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{x:Static Resources:SR.ManagedCertificateSettings_Primary}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Button
                                                            Width="20"
                                                            Margin="4,0,0,0"
                                                            AutomationProperties.Name="Set As Primary Domain"
                                                            BorderThickness="0"
                                                            Click="SetPrimaryDomainOption_Click"
                                                            Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                                            Visibility="{Binding IsPrimaryDomain, Converter={StaticResource ResourceKey=InvBoolToVisConverter}}">
                                                            <fa:ImageAwesome
                                                                Height="12"
                                                                Margin="0,0,0,0"
                                                                Foreground="{DynamicResource MahApps.Brushes.Control.Disabled}"
                                                                Icon="CircleOutline" />

                                                        </Button>

                                                        <Button
                                                            Width="20"
                                                            Margin="4,0,0,0"
                                                            AutomationProperties.Name="Selected as Primary Domain"
                                                            BorderThickness="0"
                                                            Click="SetPrimaryDomainOption_Click"
                                                            Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                                            Visibility="{Binding IsPrimaryDomain, Converter={StaticResource ResourceKey=BoolToVisConverter}}">
                                                            <fa:ImageAwesome
                                                                Height="12"
                                                                Margin="0,0,0,0"
                                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                                Icon="CheckCircleOutline" />

                                                        </Button>
                                                    </StackPanel>

                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridCheckBoxColumn
                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            EditingElementStyle="{DynamicResource MahApps.Styles.CheckBox.DataGrid}"
                                            ElementStyle="{DynamicResource MahApps.Styles.CheckBox.DataGrid}"
                                            Header="{x:Static Resources:SR.ManagedCertificateSettings_Include}" />
                                        <DataGridTextColumn
                                            MinWidth="200"
                                            Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                                            EditingElementStyle="{StaticResource MahApps.Styles.TextBox.DataGrid.Editing}"
                                            Header="{x:Static Resources:SR.ManagedCertificateSettings_Domain}"
                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Width="20"
                                                        Margin="4,0,0,0"
                                                        AutomationProperties.Name="Remove Domain"
                                                        BorderThickness="0"
                                                        Click="RemoveDomainOption_Click">
                                                        <fa:ImageAwesome
                                                            Height="12"
                                                            Margin="0,0,0,0"
                                                            Foreground="{DynamicResource MahApps.Brushes.Accent3}"
                                                            Icon="Trash" />

                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </DockPanel>

                        <DockPanel Margin="8,0,8,8" Visibility="{Binding SelectedItem.RequestConfig.CustomCSR, Converter={StaticResource ResourceKey=NullCollapsedConverter}}">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Instructions}">
                                You have set a Custom Certificate Signing Request (CSR) which will include the following domains. To specify different domains you need to update your CSR or remove it, see the Advanced tab.
                            </TextBlock>
                            <DataGrid
                                x:Name="CsrDomainOptionsList"
                                Margin="0,16,0,0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                EnableRowVirtualization="True"
                                IsReadOnly="True"
                                ItemsSource="{Binding SelectedItem.DomainOptions}"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectionMode="Single">
                                <DataGrid.Columns>


                                    <DataGridTextColumn
                                        MinWidth="200"
                                        Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                                        Header="{x:Static Resources:SR.ManagedCertificateSettings_Domain}"
                                        IsReadOnly="True" />

                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </WrapPanel>

                    <WrapPanel Orientation="Vertical" Visibility="{Binding UseAuthorityTokenListView, Converter={StaticResource ResourceKey=BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <managedcertificate:AuthorityTokenList />
                    </WrapPanel>
                </DockPanel>

            </TabItem>

            <TabItem
                MinWidth="100"
                Controls:HeaderedControlHelper.HeaderFontSize="12"
                Header="Authorization"
                IsSelected="False"
                Visibility="{Binding IsExternalManagedCertificateItem, Converter={StaticResource ResourceKey=InvBoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">
                <managedcertificate:IdentifierAuthorization />
            </TabItem>

            <TabItem
                MinWidth="100"
                Controls:HeaderedControlHelper.HeaderFontSize="12"
                Header="Advanced"
                IsSelected="False">
                <managedcertificate:AdvancedOptions />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
