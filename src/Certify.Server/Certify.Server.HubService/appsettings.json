{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Microsoft": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  // Note: JwtSettings.secret is deliberately NOT set here. It is generated per-install into
  // hubservice.json in the app data path on first run. A secret committed to this file would be
  // published with the product and would let anyone forge tokens for any security principal.
  "JwtSettings": {
    "refreshTokenExpirationInMinutes": 1440,
    "authTokenExpirationInMinutes": 60,
    "issuer": "Certify.Server.Hub.Api"
  },
  // Sign in options for the hub API.
  // Set "enablePasswordLogin" to false to accept OpenID Connect sign in only, so that built in username/password
  // credentials cannot be used to bypass the identity provider. Configure at least one OIDC provider before doing
  // this, otherwise there is no way to sign in until the setting is put back.
  "AuthSettings": {
    "enablePasswordLogin": true
  },
  // Per calling IP address limits for the endpoints reachable without an existing session.
  // Set "enabled" to false to turn limiting off. Behind a reverse proxy, configure forwarded headers,
  // otherwise every request appears to come from the proxy and shares a single bucket.
  "RateLimiting": {
    "enabled": true,
    "authRequestsPerMinute": 20,
    "tokenRefreshRequestsPerMinute": 120,
    "hubJoinRequestsPerMinute": 60,
    "acmeRequestsPerMinute": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Certify": "Information",
        "Certify.Server.Hub.Api.Controllers": "Information"
      }
    }
  }
}
